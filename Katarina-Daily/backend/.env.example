# ---- App ----
APP_ENV=development
APP_PORT=8090
# Railway (and most PaaS) inject PORT automatically; APP_PORT falls
# back to PORT if it isn't set, so you usually don't need to touch this
# in production.

# ---- Database (PostgreSQL only) ----
DATABASE_URL=postgresql://postgres:password@localhost:5432/fashion_store

# ---- JWT ----
JWT_SECRET=change_me
JWT_EXPIRY_HOURS=72

# ---- Payment gateway (Midtrans) ----
PAYMENT_GATEWAY=midtrans
PAYMENT_SERVER_KEY=
PAYMENT_CLIENT_KEY=
PAYMENT_ENVIRONMENT=sandbox

# ---- Shipping ----
# SHIPPING_API_KEY is reserved for when pkg/shipping is wired to a real
# courier aggregator (RajaOngkir, Biteship, etc). The bundled provider
# is a formula-based mock and does not use it yet.
SHIPPING_API_KEY=
SHIPPING_ORIGIN_CITY=Jakarta Selatan
SHIPPING_ORIGIN_PROVINCE=DKI Jakarta

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:3000

# ---- Rate limiting ----
RATE_LIMIT_PER_MINUTE=120
